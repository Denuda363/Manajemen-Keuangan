rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REUSABLE SECURITY PRIMITIVES ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Prevents remote script injection, directory traversal, and resource-poisoning IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- ENTITY SCHEMA VALIDATIONS (Anti-Update-Gap) ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'name', 'email', 'password'])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.password is string && data.password.size() <= 128
        && (!data.keys().contains('incomeCategories') || data.incomeCategories is list)
        && (!data.keys().contains('expenseCategories') || data.expenseCategories is list)
        && (!data.keys().contains('budgetLimits') || data.budgetLimits is map);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'method', 'amount', 'category', 'description', 'date', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && (data.type == 'pemasukan' || data.type == 'pengeluaran' || data.type == 'nabung')
        && (data.method == 'tunai' || data.method == 'transfer')
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 128
        && data.description is string && data.description.size() <= 1000
        && data.date is string && data.date.size() <= 32
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // --- SYSTEM COLLECTION ENFORCEMENTS ---

    // 1. Users Profiles and Configurations (Validated Zero-Trust ID pairing)
    match /users/{userId} {
      allow read, list: if true;
      allow create, update: if isValidId(userId) && incoming().id == userId && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // 2. Financial Transactions Tracker
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update: if isValidId(transactionId) && incoming().id == transactionId && isValidTransaction(incoming());
      allow delete: if true;
    }

    // 3. Company Profile Settings
    match /company/{companyId} {
      allow read, get, list: if true;
      allow create, update: if isValidId(companyId) && incoming().id == companyId;
      allow delete: if isValidId(companyId);
    }
  }
}
